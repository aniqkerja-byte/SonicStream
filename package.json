{
  "name": "sonic-cloud-stream",
  "version": "1.0.0",
  "description": "Self-hosted music streaming server with Cloudflare Tunnel support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:domain": "cloudflared tunnel --config cloudflared-config.yml run music-server",
    "check": "npm run test && npm run lint",
    "test": "node --test",
    "lint": "eslint server.js public/app.js public/sw.js"
  },
  "keywords": [
    "music",
    "streaming",
    "self-hosted",
    "cloudflare-tunnel"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.14.0"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6"
  }
}
